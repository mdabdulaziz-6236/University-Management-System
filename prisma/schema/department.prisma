model Department {
    id          String  @id @default(uuid())
    name        String  @unique
    shortName   String  @unique
    code        String  @unique
    description String?

    facultyId String
    faculty   Faculty @relation(fields: [facultyId], references: [id])

    headOfDeptId String? @unique
    headOfDept        Teacher?        @relation("HOD", fields: [headOfDeptId], references: [id])
    // Audit Trail
    createdById String
    createdBy   User   @relation(fields: [createdById], references: [id])

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    teachers  Teacher[]

    @@map("departments")
}
